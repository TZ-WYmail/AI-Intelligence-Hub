APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/aih.db
# Required for all data/management APIs. Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_API_KEY=
API_BASE_URL=http://127.0.0.1:8000
AI_ENABLED=false
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# provider_default / disabled / enabled; DeepSeek: disabled for low-cost structured analysis
AI_THINKING_MODE=provider_default
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_REQUEST_LIMIT=100
AI_INPUT_CNY_PER_MILLION=10
AI_OUTPUT_CNY_PER_MILLION=30
MONTHLY_AI_BUDGET_CNY=50
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
CRITICAL_ALERT_THRESHOLD=85
IMPORTANT_ALERT_THRESHOLD=60
P1_BATCH_MINUTES=60
QUIET_START_HOUR=23
QUIET_END_HOUR=7
RAW_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=180
JOB_RETENTION_DAYS=30
HTTP_TIMEOUT=20
MAX_RESPONSE_BYTES=5000000
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=300

# Local durable maintenance (no messages or additional model calls)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=7
BACKUP_DIRECTORY=./data/backups
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_HOUR=8
